# Copy to .env for local development. NEVER commit .env. On a host, set these as environment variables / secrets.

# --- AI assistant (optional; without a key the assistant says it is unavailable) ---
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# --- Contact form delivery via SMTP (optional; without it the form offers a mailto fallback) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587) | ssl (port 465) | none (local testing only)
SMTP_SECURITY=starttls
# Where messages are delivered, and the From address (use an address your SMTP account may send as)
CONTACT_TO=
CONTACT_FROM=

# --- Web ---
# Comma-separated origins allowed to call /api from a different site (only if the site is hosted separately)
ALLOWED_ORIGINS=
# Set to 1 ONLY when exactly one trusted reverse proxy sits in front (so rate limits see real client IPs)
TRUST_PROXY=0
# Minimum seconds between opening the form and submitting it (spam heuristic)
MIN_FILL_SECONDS=2
# Set to 1 to expose /docs (leave off in production)
ENABLE_DOCS=0
